classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet_name) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(title) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~Task~
        +explain_plan() str
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders and selects
