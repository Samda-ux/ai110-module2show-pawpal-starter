classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet_name) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(title) None
    }

    class Task {
        +str description
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +mark_complete() None
        +mark_incomplete() None
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +int start_minute
        +str reason
    }

    class Scheduler {
        +Owner owner
        +list~ScheduledTask~ plan
        +list~tuple~ skipped
        +get_pending_tasks() list~tuple~
        +sort_tasks(tasks) list~tuple~
        +generate_plan() list~ScheduledTask~
        +complete_task(pet_name, description) bool
        +explain_plan() str
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler "1" o-- "0..*" ScheduledTask : produces
    ScheduledTask --> Pet : for
    ScheduledTask --> Task : schedules
